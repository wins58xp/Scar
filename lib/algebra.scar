# lib/algebra.scar: matrices de cualquier tamaño y álgebra lineal (use "algebra").
#
#   use "algebra"
#
#   let a = algebra.desde_texto("2 1; 1 3")?           # filas separadas por ';'
#   let b = algebra.desde_texto("3; 5")?
#   let x = algebra.resolver(a, b)?                    # a * x = b
#   print(algebra.a_texto_mat(x, 4))                   # "0.8000; 1.4000"
#   print(algebra.determinante(a))                     # 5
#
# Qué hay:
# - Matriz: filas x columnas de f64, guardadas por filas. Se arma con matriz (ceros), identidad,
#   desde_texto ("1 2; 3 4") o de a un número con poner. Un vector es una matriz de una columna.
# - Cuentas: suma, resta, escala, producto, transpuesta, traza, norma (de Frobenius), copia e
#   iguales_casi (comparar con tolerancia); a_texto_mat y decimales para mostrarlas. Si las
#   dimensiones no encajan es un panic que dice cuáles.
# - Sistemas: determinante, resolver (a * x = b, con b de una o varias columnas), inversa y rango,
#   con eliminación gaussiana con pivoteo parcial (el pivote es el de mayor valor absoluto de la
#   columna, así no se divide por números chicos). Una matriz singular (o casi: un pivote menor que
#   10 * n * 2^-52 por la mayor suma de valores absolutos de una fila) da Err en resolver e inversa,
#   determinante 0, y no suma en rango.
# - minimos_cuadrados(a, b): el x que hace más chico |a * x - b| cuando hay más ecuaciones que
#   incógnitas (para ajustar rectas o curvas a datos), con QR de Householder, que no eleva al cuadrado
#   el número de condición como las ecuaciones normales (a^T a) x = a^T b.
# - propios(a): valores y vectores propios de una matriz simétrica (método de Jacobi), los valores
#   de menor a mayor y cada vector como columna, de largo 1.

struct Matriz {
    filas: i32
    cols: i32
    v: Vec<f64>
}

fn matriz(filas: i32, columnas: i32) -> Matriz {
    if filas < 0 or columnas < 0 {
        panic("algebra.matriz: dimensiones negativas")
    }
    let v: Vec<f64> = vec_new()
    for k in 0..filas * columnas {
        v.push(0.0)
    }
    return Matriz { filas: filas, cols: columnas, v: v }
}

fn identidad(n: i32) -> Matriz {
    let m = matriz(n, n)
    for i in 0..n {
        m.v.set(i * n + i, 1.0)
    }
    return m
}

fn filas(m: Matriz) -> i32 {
    return m.filas
}

fn columnas(m: Matriz) -> i32 {
    return m.cols
}

fn _dentro(m: Matriz, i: i32, j: i32, quien: str) {
    if i < 0 or j < 0 or i >= m.filas or j >= m.cols {
        panic("algebra." + quien + ": (" + a_texto(i) + ", " + a_texto(j) + ") fuera de una matriz de " + a_texto(m.filas) + " x " + a_texto(m.cols))
    }
}

# get(m, i, j) -> f64: el número de la fila i y la columna j (desde 0).
fn get(m: Matriz, i: i32, j: i32) -> f64 {
    _dentro(m, i, j, "get")
    return m.v.get(i * m.cols + j).unwrap_or(0.0)
}

fn poner(m: Matriz, i: i32, j: i32, x: f64) {
    _dentro(m, i, j, "poner")
    m.v.set(i * m.cols + j, x)
}

fn _g(m: Matriz, i: i32, j: i32) -> f64 {
    return m.v.get(i * m.cols + j).unwrap_or(0.0)
}

fn _p(m: Matriz, i: i32, j: i32, x: f64) {
    m.v.set(i * m.cols + j, x)
}

fn copia(m: Matriz) -> Matriz {
    let c = matriz(m.filas, m.cols)
    for k in 0..m.filas * m.cols {
        c.v.set(k, m.v.get(k).unwrap_or(0.0))
    }
    return c
}

# ---- texto ----------------------------------------------------------------------------------

fn _es_espacio(c: str) -> bool {
    return c == " " or c == "\t" or c == "\n" or c == "\r" or c == ","
}

# un número decimal: [-+]cifras[.cifras][e[-+]cifras]
fn _numero(p: str) -> Result<f64> {
    let n = len(p)
    let mut i = 0
    let mut signo = 1.0
    if i < n and (p[i] == "-" or p[i] == "+") {
        if p[i] == "-" {
            signo = 0.0 - 1.0
        }
        i = i + 1
    }
    let mut ent = 0.0
    let mut cifras = 0
    while i < n and ord(p[i]) >= 48 and ord(p[i]) <= 57 {
        ent = ent * 10.0 + to_f64(ord(p[i]) - 48)
        cifras = cifras + 1
        i = i + 1
    }
    let mut frac = 0.0
    let mut escala = 1.0
    if i < n and p[i] == "." {
        i = i + 1
        while i < n and ord(p[i]) >= 48 and ord(p[i]) <= 57 {
            frac = frac * 10.0 + to_f64(ord(p[i]) - 48)
            escala = escala * 10.0
            cifras = cifras + 1
            i = i + 1
        }
    }
    if cifras == 0 {
        return Err("algebra.desde_texto: '" + p + "' no es un número")
    }
    let mut x = ent + frac / escala
    if i < n and (p[i] == "e" or p[i] == "E") {
        i = i + 1
        let mut se = 1
        if i < n and (p[i] == "-" or p[i] == "+") {
            if p[i] == "-" {
                se = 0 - 1
            }
            i = i + 1
        }
        let mut e = 0
        let mut ce = 0
        while i < n and ord(p[i]) >= 48 and ord(p[i]) <= 57 and e < 1000 {
            e = e * 10 + (ord(p[i]) - 48)
            ce = ce + 1
            i = i + 1
        }
        if ce == 0 {
            return Err("algebra.desde_texto: '" + p + "' no es un número")
        }
        for k in 0..e {
            if se > 0 {
                x = x * 10.0
            } else {
                x = x / 10.0
            }
        }
    }
    if i != n {
        return Err("algebra.desde_texto: '" + p + "' no es un número")
    }
    return Ok(signo * x)
}

# desde_texto(s) -> Result<Matriz>: "1 2 3; 4 5 6" es una matriz de 2 x 3 (los números se separan con
# espacios o comas, las filas con ';' o con saltos de línea). Todas las filas tienen que tener la misma
# cantidad de números.
fn desde_texto(s: str) -> Result<Matriz> {
    let v: Vec<f64> = vec_new()
    let n = len(s)
    let mut filas = 0
    let mut cols = 0 - 1
    let mut en_fila = 0
    let mut palabra = ""
    let mut i = 0
    while i <= n {
        let fin = i == n
        let mut c = ""
        if not fin {
            c = s[i]
        }
        let corta_fila = fin or c == ";" or c == "\n"
        if fin or _es_espacio(c) or c == ";" {
            if len(palabra) > 0 {
                let x = _numero(palabra)?
                v.push(x)
                en_fila = en_fila + 1
                palabra = ""
            }
        } else {
            palabra = palabra + c
        }
        if corta_fila and en_fila > 0 {
            if cols >= 0 and en_fila != cols {
                return Err("algebra.desde_texto: la fila " + a_texto(filas + 1) + " tiene " + a_texto(en_fila) + " números y las anteriores " + a_texto(cols))
            }
            cols = en_fila
            filas = filas + 1
            en_fila = 0
        }
        i = i + 1
    }
    if filas == 0 {
        return Err("algebra.desde_texto: no hay números")
    }
    return Ok(Matriz { filas: filas, cols: cols, v: v })
}

# a_texto_mat(m, decimales) -> str: "1.00 2.00; 3.00 4.00".
fn a_texto_mat(m: Matriz, n: i32) -> str {
    let mut s = ""
    for i in 0..m.filas {
        if i > 0 {
            s = s + "; "
        }
        for j in 0..m.cols {
            if j > 0 {
                s = s + " "
            }
            s = s + decimales(_g(m, i, j), n)
        }
    }
    return s
}

# decimales(x, n) -> str: x con n decimales redondeados ("3.14"), para mostrar un número suelto.
fn decimales(x: f64, n: i32) -> str {
    let mut escala = 1.0
    for k in 0..n {
        escala = escala * 10.0
    }
    let mut v = x
    let mut signo = ""
    if v < 0.0 {
        signo = "-"
        v = 0.0 - v
    }
    let entero = to_i64(floor(v * escala + 0.5))
    if entero == 0 {
        signo = ""
    }
    if n <= 0 {
        return signo + a_texto(entero)
    }
    let pot = to_i64(escala)
    let mut frac = a_texto(entero % pot)
    while len(frac) < n {
        frac = "0" + frac
    }
    return signo + a_texto(entero / pot) + "." + frac
}

# ---- cuentas ------------------------------------------------------------------------------

fn _misma_forma(a: Matriz, b: Matriz, quien: str) {
    if a.filas != b.filas or a.cols != b.cols {
        panic("algebra." + quien + ": no se pueden operar una matriz de " + a_texto(a.filas) + " x " + a_texto(a.cols) + " y una de " + a_texto(b.filas) + " x " + a_texto(b.cols))
    }
}

fn suma(a: Matriz, b: Matriz) -> Matriz {
    _misma_forma(a, b, "suma")
    let c = matriz(a.filas, a.cols)
    for k in 0..a.filas * a.cols {
        c.v.set(k, a.v.get(k).unwrap_or(0.0) + b.v.get(k).unwrap_or(0.0))
    }
    return c
}

fn resta(a: Matriz, b: Matriz) -> Matriz {
    _misma_forma(a, b, "resta")
    let c = matriz(a.filas, a.cols)
    for k in 0..a.filas * a.cols {
        c.v.set(k, a.v.get(k).unwrap_or(0.0) - b.v.get(k).unwrap_or(0.0))
    }
    return c
}

fn escala(a: Matriz, k: f64) -> Matriz {
    let c = matriz(a.filas, a.cols)
    for i in 0..a.filas * a.cols {
        c.v.set(i, a.v.get(i).unwrap_or(0.0) * k)
    }
    return c
}

# producto(a, b): a * b (a de m x n, b de n x p).
fn producto(a: Matriz, b: Matriz) -> Matriz {
    if a.cols != b.filas {
        panic("algebra.producto: una matriz de " + a_texto(a.filas) + " x " + a_texto(a.cols) + " no se multiplica por una de " + a_texto(b.filas) + " x " + a_texto(b.cols))
    }
    let c = matriz(a.filas, b.cols)
    for i in 0..a.filas {
        for j in 0..b.cols {
            let mut s = 0.0
            for k in 0..a.cols {
                s = s + _g(a, i, k) * _g(b, k, j)
            }
            _p(c, i, j, s)
        }
    }
    return c
}

fn transpuesta(a: Matriz) -> Matriz {
    let c = matriz(a.cols, a.filas)
    for i in 0..a.filas {
        for j in 0..a.cols {
            _p(c, j, i, _g(a, i, j))
        }
    }
    return c
}

fn traza(a: Matriz) -> f64 {
    let mut s = 0.0
    for i in 0..min(a.filas, a.cols) {
        s = s + _g(a, i, i)
    }
    return s
}

# norma de Frobenius: raíz de la suma de los cuadrados (para un vector, su largo)
fn norma(a: Matriz) -> f64 {
    let mut s = 0.0
    for k in 0..a.filas * a.cols {
        let x = a.v.get(k).unwrap_or(0.0)
        s = s + x * x
    }
    return sqrt(s)
}

fn _maximo_abs(a: Matriz) -> f64 {
    let mut m = 0.0
    for k in 0..a.filas * a.cols {
        m = max(m, abs(a.v.get(k).unwrap_or(0.0)))
    }
    return m
}

# iguales_casi(a, b, tol) -> bool: misma forma y cada número a menos de tol del otro.
fn iguales_casi(a: Matriz, b: Matriz, tol: f64) -> bool {
    if a.filas != b.filas or a.cols != b.cols {
        return false
    }
    for k in 0..a.filas * a.cols {
        if abs(a.v.get(k).unwrap_or(0.0) - b.v.get(k).unwrap_or(0.0)) > tol {
            return false
        }
    }
    return true
}

# ---- eliminación gaussiana ----------------------------------------------------------------

fn _cuadrada(a: Matriz, quien: str) {
    if a.filas != a.cols {
        panic("algebra." + quien + ": la matriz tiene que ser cuadrada y es de " + a_texto(a.filas) + " x " + a_texto(a.cols))
    }
}

# el umbral bajo el cual un pivote se toma como cero: 10 * n * 2^-52 * (la mayor suma de valores absolutos
# de una fila). El redondeo de la eliminación crece con n y con el tamaño de las filas; con un umbral
# más chico, una matriz singular puede dejar un pivote de "ruido" (1e-13) que pasa por bueno.
fn _umbral(a: Matriz) -> f64 {
    let mut fila_max = 0.0
    for i in 0..a.filas {
        let mut s = 0.0
        for j in 0..a.cols {
            s = s + abs(_g(a, i, j))
        }
        fila_max = max(fila_max, s)
    }
    return 10.0 * to_f64(max(a.filas, a.cols)) * 2.220446049250313e-16 * fila_max
}

fn _cambiar_filas(m: Matriz, i: i32, k: i32) {
    if i == k {
        return
    }
    for j in 0..m.cols {
        let t = _g(m, i, j)
        _p(m, i, j, _g(m, k, j))
        _p(m, k, j, t)
    }
}

# la fila (desde `desde`) con el mayor valor absoluto en la columna j
fn _pivote(m: Matriz, desde: i32, j: i32) -> i32 {
    let mut p = desde
    for i in desde + 1..m.filas {
        if abs(_g(m, i, j)) > abs(_g(m, p, j)) {
            p = i
        }
    }
    return p
}

# determinante(a) -> f64 (0 si la matriz es singular según el umbral). Panic si no es cuadrada.
fn determinante(a: Matriz) -> f64 {
    _cuadrada(a, "determinante")
    let n = a.filas
    let m = copia(a)
    let tol = _umbral(a)
    let mut det = 1.0
    for j in 0..n {
        let p = _pivote(m, j, j)
        if abs(_g(m, p, j)) <= tol {
            return 0.0
        }
        if p != j {
            _cambiar_filas(m, p, j)
            det = 0.0 - det
        }
        let piv = _g(m, j, j)
        det = det * piv
        for i in j + 1..n {
            let f = _g(m, i, j) / piv
            if f != 0.0 {
                for k in j..n {
                    _p(m, i, k, _g(m, i, k) - f * _g(m, j, k))
                }
            }
        }
    }
    return det
}

# resolver(a, b) -> Result<Matriz>: el x con a * x = b (a cuadrada de n x n, b de n x k). Err si a es
# singular.
fn resolver(a: Matriz, b: Matriz) -> Result<Matriz> {
    _cuadrada(a, "resolver")
    if b.filas != a.filas {
        panic("algebra.resolver: a tiene " + a_texto(a.filas) + " filas y b " + a_texto(b.filas))
    }
    let n = a.filas
    let k = b.cols
    let m = copia(a)
    let x = copia(b)
    let tol = _umbral(a)
    for j in 0..n {
        let p = _pivote(m, j, j)
        if abs(_g(m, p, j)) <= tol {
            return Err("algebra.resolver: la matriz es singular (o casi)")
        }
        _cambiar_filas(m, p, j)
        _cambiar_filas(x, p, j)
        let piv = _g(m, j, j)
        for i in j + 1..n {
            let f = _g(m, i, j) / piv
            if f != 0.0 {
                for c in j..n {
                    _p(m, i, c, _g(m, i, c) - f * _g(m, j, c))
                }
                for c in 0..k {
                    _p(x, i, c, _g(x, i, c) - f * _g(x, j, c))
                }
            }
        }
    }
    # sustitución hacia atrás
    let mut i = n - 1
    while i >= 0 {
        for c in 0..k {
            let mut s = _g(x, i, c)
            for t in i + 1..n {
                s = s - _g(m, i, t) * _g(x, t, c)
            }
            _p(x, i, c, s / _g(m, i, i))
        }
        i = i - 1
    }
    return Ok(x)
}

# inversa(a) -> Result<Matriz>. Err si a es singular.
fn inversa(a: Matriz) -> Result<Matriz> {
    _cuadrada(a, "inversa")
    let r = resolver(a, identidad(a.filas))?
    return Ok(r)
}

# rango(a) -> i32: cuántas filas (o columnas) independientes tiene.
fn rango(a: Matriz) -> i32 {
    let m = copia(a)
    let tol = _umbral(a)
    let mut r = 0
    let mut j = 0
    while j < m.cols and r < m.filas {
        let p = _pivote(m, r, j)
        if abs(_g(m, p, j)) > tol {
            _cambiar_filas(m, p, r)
            let piv = _g(m, r, j)
            for i in r + 1..m.filas {
                let f = _g(m, i, j) / piv
                for c in j..m.cols {
                    _p(m, i, c, _g(m, i, c) - f * _g(m, r, c))
                }
            }
            r = r + 1
        }
        j = j + 1
    }
    return r
}

# ---- mínimos cuadrados (QR de Householder) ---------------------------------------------------

# minimos_cuadrados(a, b) -> Result<Matriz>: el x (n x k) que minimiza |a x - b| con a de m x n, m >= n.
# Err si hay menos ecuaciones que incógnitas o si las columnas de a no son independientes.
fn minimos_cuadrados(a: Matriz, b: Matriz) -> Result<Matriz> {
    let m = a.filas
    let n = a.cols
    if b.filas != m {
        panic("algebra.minimos_cuadrados: a tiene " + a_texto(m) + " filas y b " + a_texto(b.filas))
    }
    if m < n {
        return Err("algebra.minimos_cuadrados: hay menos ecuaciones (" + a_texto(m) + ") que incógnitas (" + a_texto(n) + ")")
    }
    let r = copia(a)
    let y = copia(b)
    let tol = _umbral(a)
    let v: Vec<f64> = vec_new()
    for i in 0..m {
        v.push(0.0)
    }
    for j in 0..n {
        # el reflector que lleva la columna j (de la fila j para abajo) a un múltiplo de e_j
        let mut s = 0.0
        for i in j..m {
            s = s + _g(r, i, j) * _g(r, i, j)
        }
        let nrm = sqrt(s)
        if nrm <= tol {
            return Err("algebra.minimos_cuadrados: las columnas de la matriz no son independientes")
        }
        let alfa = if _g(r, j, j) > 0.0 { 0.0 - nrm } else { nrm }
        let mut vv = 0.0
        for i in j..m {
            let vi = if i == j { _g(r, i, j) - alfa } else { _g(r, i, j) }
            v.set(i, vi)
            vv = vv + vi * vi
        }
        # aplicar H = I - 2 v v^T / (v^T v) a las columnas de r y de y
        for c in j..n {
            let mut d = 0.0
            for i in j..m {
                d = d + v.get(i).unwrap_or(0.0) * _g(r, i, c)
            }
            let f = 2.0 * d / vv
            for i in j..m {
                _p(r, i, c, _g(r, i, c) - f * v.get(i).unwrap_or(0.0))
            }
        }
        for c in 0..y.cols {
            let mut d = 0.0
            for i in j..m {
                d = d + v.get(i).unwrap_or(0.0) * _g(y, i, c)
            }
            let f = 2.0 * d / vv
            for i in j..m {
                _p(y, i, c, _g(y, i, c) - f * v.get(i).unwrap_or(0.0))
            }
        }
        if abs(_g(r, j, j)) <= tol {
            return Err("algebra.minimos_cuadrados: las columnas de la matriz no son independientes")
        }
    }
    # r x = (Q^T b) en las primeras n filas
    let x = matriz(n, b.cols)
    for c in 0..b.cols {
        let mut i = n - 1
        while i >= 0 {
            let mut s = _g(y, i, c)
            for t in i + 1..n {
                s = s - _g(r, i, t) * _g(x, t, c)
            }
            _p(x, i, c, s / _g(r, i, i))
            i = i - 1
        }
    }
    return Ok(x)
}

# ---- valores y vectores propios (Jacobi, matrices simétricas) --------------------------------

struct Propios {
    valores: Matriz
    vectores: Matriz
}

# propios(a) -> Result<Propios>: los valores propios de menor a mayor (una columna de n) y los vectores
# propios como columnas de una matriz de n x n, cada uno de largo 1 y con su número de mayor valor
# absoluto positivo (así el resultado no depende de un signo arbitrario). Err si a no es simétrica.
fn propios(a: Matriz) -> Result<Propios> {
    _cuadrada(a, "propios")
    let n = a.filas
    let escala_a = _maximo_abs(a)
    for i in 0..n {
        for j in i + 1..n {
            if abs(_g(a, i, j) - _g(a, j, i)) > 1.0e-12 * max(1.0, escala_a) {
                return Err("algebra.propios: la matriz no es simétrica")
            }
        }
    }
    let m = copia(a)
    let q = identidad(n)
    let mut vuelta = 0
    let mut sigue = n > 1
    while sigue and vuelta < 100 {
        let mut fuera = 0.0
        for i in 0..n {
            for j in i + 1..n {
                fuera = fuera + _g(m, i, j) * _g(m, i, j)
            }
        }
        if fuera <= 1.0e-30 * max(1.0, escala_a * escala_a) {
            sigue = false
        } else {
            for p in 0..n {
                for r in p + 1..n {
                    let apr = _g(m, p, r)
                    if apr != 0.0 {
                        # la rotación que anula m[p][r]
                        let theta = (_g(m, r, r) - _g(m, p, p)) / (2.0 * apr)
                        let mut t = 1.0 / (abs(theta) + sqrt(theta * theta + 1.0))
                        if theta < 0.0 {
                            t = 0.0 - t
                        }
                        let c = 1.0 / sqrt(t * t + 1.0)
                        let s = t * c
                        for k in 0..n {
                            let mkp = _g(m, k, p)
                            let mkr = _g(m, k, r)
                            _p(m, k, p, c * mkp - s * mkr)
                            _p(m, k, r, s * mkp + c * mkr)
                        }
                        for k in 0..n {
                            let mpk = _g(m, p, k)
                            let mrk = _g(m, r, k)
                            _p(m, p, k, c * mpk - s * mrk)
                            _p(m, r, k, s * mpk + c * mrk)
                        }
                        for k in 0..n {
                            let qkp = _g(q, k, p)
                            let qkr = _g(q, k, r)
                            _p(q, k, p, c * qkp - s * qkr)
                            _p(q, k, r, s * qkp + c * qkr)
                        }
                    }
                }
            }
            vuelta = vuelta + 1
        }
    }
    # ordenar de menor a mayor (selección) y normalizar el signo de cada vector
    let valores = matriz(n, 1)
    let vectores = matriz(n, n)
    let usado: Vec<i32> = vec_new()
    for i in 0..n {
        usado.push(0)
    }
    for col in 0..n {
        let mut b = 0 - 1
        for i in 0..n {
            if usado.get(i).unwrap_or(1) == 0 and (b < 0 or _g(m, i, i) < _g(m, b, b)) {
                b = i
            }
        }
        usado.set(b, 1)
        _p(valores, col, 0, _g(m, b, b))
        let mut grande = 0
        for k in 1..n {
            if abs(_g(q, k, b)) > abs(_g(q, grande, b)) {
                grande = k
            }
        }
        let sg = if _g(q, grande, b) < 0.0 { 0.0 - 1.0 } else { 1.0 }
        for k in 0..n {
            _p(vectores, k, col, sg * _g(q, k, b))
        }
    }
    return Ok(Propios { valores: valores, vectores: vectores })
}
