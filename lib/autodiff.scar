# lib/autodiff.scar: derivadas automáticas (use "autodiff").
#
# Se arma una cuenta paso a paso sobre una "cinta" (Cinta), que recuerda cada
# operación; después `derivar` recorre la cinta al revés y deja en cada valor
# su derivada respecto del resultado (modo reverso, regla de la cadena). Nadie
# escribe la fórmula de la derivada: si la cuenta cambia, la derivada sale
# sola.
#
#   use "autodiff"
#
#   fn main() {
#       let c = autodiff.cinta()
#       let x = autodiff.variable(c, 3.0)
#       let y = autodiff.mul(c, x, x)              # y = x²
#       autodiff.derivar(c, y)
#       print(autodiff.valor(c, y))                # 9.0
#       print(autodiff.gradiente(c, x))            # 6.0  (dy/dx = 2x)
#   }
#
# Cada valor es un número (i32) que lo identifica en su cinta. Una cinta crece
# con cada operación: para entrenar, `limpiar` la vacía antes de cada paso
# (los valores viejos dejan de existir).
#
# Operaciones: suma, resta, mul, div, neg, cuadrado, exponencial, logaritmo,
# tanh, sigmoide, relu, y escalar (multiplicar por un número fijo). Todo en f64.
# Probada contra derivadas numéricas (diferencias centradas).

struct Cinta {
    valores: Vec<f64>
    grads: Vec<f64>
    ops: Vec<i32>
    izq: Vec<i32>
    der: Vec<i32>
    # para escalar: el número fijo por el que se multiplica
    fijos: Vec<f64>
}

# los códigos de operación
fn _hoja() -> i32 { return 0 }
fn _suma() -> i32 { return 1 }
fn _resta() -> i32 { return 2 }
fn _mul() -> i32 { return 3 }
fn _div() -> i32 { return 4 }
fn _neg() -> i32 { return 5 }
fn _exp() -> i32 { return 6 }
fn _ln() -> i32 { return 7 }
fn _tanh() -> i32 { return 8 }
fn _sigmoide() -> i32 { return 9 }
fn _relu() -> i32 { return 10 }
fn _escalar() -> i32 { return 11 }

# Una cinta vacía.
fn cinta() -> Cinta {
    return Cinta { valores: vec_new(), grads: vec_new(), ops: vec_new(), izq: vec_new(), der: vec_new(), fijos: vec_new() }
}

# Vacía la cinta (para el paso siguiente de un entrenamiento).
fn limpiar(c: Cinta) {
    c.valores = vec_new()
    c.grads = vec_new()
    c.ops = vec_new()
    c.izq = vec_new()
    c.der = vec_new()
    c.fijos = vec_new()
}

# Cuántos valores tiene la cinta.
fn largo(c: Cinta) -> i32 {
    return c.valores.len()
}

fn _nuevo(c: Cinta, v: f64, op: i32, a: i32, b: i32, fijo: f64) -> i32 {
    c.valores.push(v)
    c.grads.push(0.0)
    c.ops.push(op)
    c.izq.push(a)
    c.der.push(b)
    c.fijos.push(fijo)
    return c.valores.len() - 1
}

fn _revisar(c: Cinta, i: i32) {
    if i < 0 or i >= c.valores.len() {
        panic("autodiff: el valor " + a_texto(i) + " no es de esta cinta (tiene " + a_texto(c.valores.len()) + ")")
    }
}

# El valor de `i`.
fn valor(c: Cinta, i: i32) -> f64 {
    _revisar(c, i)
    return c.valores.get(i).unwrap_or(0.0)
}

# La derivada del último resultado pasado a `derivar` respecto de `i`.
fn gradiente(c: Cinta, i: i32) -> f64 {
    _revisar(c, i)
    return c.grads.get(i).unwrap_or(0.0)
}

# Un número del que se quiere la derivada (un peso, una entrada).
fn variable(c: Cinta, v: f64) -> i32 {
    return _nuevo(c, v, _hoja(), -1, -1, 0.0)
}

# Un número fijo. Es lo mismo que una variable: su derivada se calcula igual,
# solo que nadie la mira.
fn constante(c: Cinta, v: f64) -> i32 {
    return variable(c, v)
}

fn suma(c: Cinta, a: i32, b: i32) -> i32 {
    return _nuevo(c, valor(c, a) + valor(c, b), _suma(), a, b, 0.0)
}

fn resta(c: Cinta, a: i32, b: i32) -> i32 {
    return _nuevo(c, valor(c, a) - valor(c, b), _resta(), a, b, 0.0)
}

fn mul(c: Cinta, a: i32, b: i32) -> i32 {
    return _nuevo(c, valor(c, a) * valor(c, b), _mul(), a, b, 0.0)
}

# a / b (b = 0 da infinito o NaN, como en f64).
fn div(c: Cinta, a: i32, b: i32) -> i32 {
    return _nuevo(c, valor(c, a) / valor(c, b), _div(), a, b, 0.0)
}

fn neg(c: Cinta, a: i32) -> i32 {
    return _nuevo(c, 0.0 - valor(c, a), _neg(), a, -1, 0.0)
}

# a * k, con k un número fijo.
fn escalar(c: Cinta, a: i32, k: f64) -> i32 {
    return _nuevo(c, valor(c, a) * k, _escalar(), a, -1, k)
}

fn cuadrado(c: Cinta, a: i32) -> i32 {
    return mul(c, a, a)
}

fn exponencial(c: Cinta, a: i32) -> i32 {
    return _nuevo(c, exp(valor(c, a)), _exp(), a, -1, 0.0)
}

# Logaritmo natural (a tiene que ser positivo).
fn logaritmo(c: Cinta, a: i32) -> i32 {
    return _nuevo(c, ln(valor(c, a)), _ln(), a, -1, 0.0)
}

fn _tanh_f(x: f64) -> f64 {
    # sin desbordar exp para |x| grande
    if x > 20.0 {
        return 1.0
    }
    if x < -20.0 {
        return -1.0
    }
    let e2 = exp(2.0 * x)
    return (e2 - 1.0) / (e2 + 1.0)
}

fn _sigmoide_f(x: f64) -> f64 {
    if x >= 0.0 {
        return 1.0 / (1.0 + exp(0.0 - x))
    }
    let e = exp(x)
    return e / (1.0 + e)
}

fn tanh(c: Cinta, a: i32) -> i32 {
    return _nuevo(c, _tanh_f(valor(c, a)), _tanh(), a, -1, 0.0)
}

fn sigmoide(c: Cinta, a: i32) -> i32 {
    return _nuevo(c, _sigmoide_f(valor(c, a)), _sigmoide(), a, -1, 0.0)
}

fn relu(c: Cinta, a: i32) -> i32 {
    let x = valor(c, a)
    let mut r = 0.0
    if x > 0.0 {
        r = x
    }
    return _nuevo(c, r, _relu(), a, -1, 0.0)
}

fn _acumular(c: Cinta, i: i32, g: f64) {
    c.grads.set(i, c.grads.get(i).unwrap_or(0.0) + g)
}

# Calcula la derivada de `salida` respecto de cada valor de la cinta. Los
# gradientes de una llamada anterior se borran antes.
fn derivar(c: Cinta, salida: i32) {
    _revisar(c, salida)
    let n = c.valores.len()
    let mut k = 0
    while k < n {
        c.grads.set(k, 0.0)
        k = k + 1
    }
    c.grads.set(salida, 1.0)
    let mut i = salida
    while i >= 0 {
        let g = c.grads.get(i).unwrap_or(0.0)
        let op = c.ops.get(i).unwrap_or(0)
        let a = c.izq.get(i).unwrap_or(-1)
        let b = c.der.get(i).unwrap_or(-1)
        let v = c.valores.get(i).unwrap_or(0.0)
        if op == _suma() {
            _acumular(c, a, g)
            _acumular(c, b, g)
        } else if op == _resta() {
            _acumular(c, a, g)
            _acumular(c, b, 0.0 - g)
        } else if op == _mul() {
            _acumular(c, a, g * valor(c, b))
            _acumular(c, b, g * valor(c, a))
        } else if op == _div() {
            let vb = valor(c, b)
            _acumular(c, a, g / vb)
            _acumular(c, b, 0.0 - g * valor(c, a) / (vb * vb))
        } else if op == _neg() {
            _acumular(c, a, 0.0 - g)
        } else if op == _escalar() {
            _acumular(c, a, g * c.fijos.get(i).unwrap_or(0.0))
        } else if op == _exp() {
            _acumular(c, a, g * v)
        } else if op == _ln() {
            _acumular(c, a, g / valor(c, a))
        } else if op == _tanh() {
            _acumular(c, a, g * (1.0 - v * v))
        } else if op == _sigmoide() {
            _acumular(c, a, g * v * (1.0 - v))
        } else if op == _relu() {
            if valor(c, a) > 0.0 {
                _acumular(c, a, g)
            }
        }
        i = i - 1
    }
}
