# lib/colores.scar: colores, espacios de color, paletas y mapas de color (use "colores").
#
#   use "colores"
#
#   let c = colores.rgb(255, 128, 0)                     # un color, como en lienzo.color
#   print(colores.a_hex(c))                              # #ff8000
#   let m = colores.mezclar_oklab(c, colores.rgb(0, 0, 255), 0.5)
#   let hsl = colores.a_hsl(c)                           # tono en grados, saturación y luz de 0 a 1
#   print(colores.contraste(c, colores.rgb(255, 255, 255)))   # relación de contraste WCAG
#   match colores.mapa("viridis") {                      # un mapa de color de 256 pasos
#       Ok(v) => print(colores.a_hex(colores.mapa_en(v, 0.3)))
#       Err(e) => print(e)
#   }
#   match colores.con_nombre("rebeccapurple") {          # los 148 nombres de CSS
#       Ok(p) => print(colores.a_hex(p))
#       Err(e) => print(e)
#   }
#
# Escrita entera en SCAR. Un color es un i32 con
# alfa, rojo, verde y azul de 8 bits (0xAARRGGBB), igual que lienzo.color y
# grafico.color_rgb: lo que arma esta lib se pasa tal cual a lienzo, imagen y grafico.
# gui usa solo rojo, verde y azul: `colores.a_gui(c)` le quita el alfa.
#
# - Espacios: HSV, HSL (tono en grados), CIE Lab (D65, 2°) y Oklab, de ida y de vuelta;
# - operaciones: mezclar (en sRGB o en Oklab, que da degradados más parejos), aclarar,
#   oscurecer, saturar, girar el tono, invertir, gris, complementario;
# - accesibilidad: luminancia y contraste WCAG, el texto blanco o negro que se lee mejor
#   sobre un fondo, diferencia de color CIEDE2000 y simulación de daltonismo (protanopia,
#   deuteranopia, tritanopia y acromatopsia, modelo de Machado, Oliveira y Fernandes);
# - 148 colores con nombre de CSS (con_nombre, nombre_mas_cercano);
# - paletas de colores distintos (las de matplotlib: tab10, tab20, set1, set2, set3,
#   dark2, paired, accent, pastel1, pastel2, y okabe_ito, pensada para daltonismo) y
#   mapas continuos de 256 pasos (viridis, magma, inferno, plasma, cividis, turbo,
#   coolwarm, rdbu, spectral, ylgnbu, greys, hot), que dan lo mismo que matplotlib;
# - degradados entre varios colores y `paleta_n`, n colores bien repartidos.
#
# Las tablas de nombres, paletas y mapas salen de matplotlib.
# Probada contra colorsys, scikit-image y matplotlib.

use "texto"

# ---------- colores sueltos ----------

fn _tope(x: i32) -> i32 {
    if x < 0 {
        return 0
    }
    if x > 255 {
        return 255
    }
    return x
}

# Un color opaco con rojo, verde y azul de 0 a 255 (lo que pase de ahí se recorta).
fn rgb(r: i32, g: i32, b: i32) -> i32 {
    return rgba(r, g, b, 255)
}

# Un color con alfa (0 transparente, 255 opaco).
fn rgba(r: i32, g: i32, b: i32, a: i32) -> i32 {
    return (_tope(a) << 24) | (_tope(r) << 16) | (_tope(g) << 8) | _tope(b)
}

fn canal_r(c: i32) -> i32 {
    return (c >> 16) & 255
}

fn canal_g(c: i32) -> i32 {
    return (c >> 8) & 255
}

fn canal_b(c: i32) -> i32 {
    return c & 255
}

fn canal_a(c: i32) -> i32 {
    return (c >> 24) & 255
}

# El color sin alfa, para gui (0xRRGGBB).
fn a_gui(c: i32) -> i32 {
    return c & 16777215
}

# Un color opaco a partir de un 0xRRGGBB.
fn de_gui(c: i32) -> i32 {
    return (255 << 24) | (c & 16777215)
}

fn _digito(n: i32) -> str {
    let t = "0123456789abcdef"
    return t[n]
}

fn _dos_hex(n: i32) -> str {
    return _digito((n >> 4) & 15) + _digito(n & 15)
}

# "#rrggbb" en minúsculas.
fn a_hex(c: i32) -> str {
    return "#" + _dos_hex(canal_r(c)) + _dos_hex(canal_g(c)) + _dos_hex(canal_b(c))
}

# "#rrggbbaa" (CSS), con el alfa al final.
fn a_hex_a(c: i32) -> str {
    return a_hex(c) + _dos_hex(canal_a(c))
}

fn _valor_hex(ch: str) -> i32 {
    let k = ord(ch)
    if k >= 48 and k <= 57 {
        return k - 48
    }
    if k >= 97 and k <= 102 {
        return k - 87
    }
    if k >= 65 and k <= 70 {
        return k - 55
    }
    return 0 - 1
}

# Lee "#rgb", "#rgba", "#rrggbb" o "#rrggbbaa" (el # es opcional; mayúsculas o
# minúsculas).
fn de_hex(s: str) -> Result<i32> {
    let mut t = s
    if t.len() > 0 and t[0] == "#" {
        t = texto.subtexto(t, 1, t.len())
    }
    let n = t.len()
    if n != 3 and n != 4 and n != 6 and n != 8 {
        return Err("color: '" + s + "' no es un color hexadecimal (#rgb, #rgba, #rrggbb o #rrggbbaa)")
    }
    let v: Vec<i32> = vec_new()
    for i in 0..n {
        let d = _valor_hex(t[i])
        if d < 0 {
            return Err("color: '" + s + "' tiene un carácter que no es hexadecimal")
        }
        v.push(d)
    }
    if n <= 4 {
        let a = if n == 4 { v.get(3).unwrap_or(15) * 17 } else { 255 }
        return Ok(rgba(v.get(0).unwrap_or(0) * 17, v.get(1).unwrap_or(0) * 17, v.get(2).unwrap_or(0) * 17, a))
    }
    let a = if n == 8 { v.get(6).unwrap_or(15) * 16 + v.get(7).unwrap_or(15) } else { 255 }
    return Ok(rgba(v.get(0).unwrap_or(0) * 16 + v.get(1).unwrap_or(0), v.get(2).unwrap_or(0) * 16 + v.get(3).unwrap_or(0), v.get(4).unwrap_or(0) * 16 + v.get(5).unwrap_or(0), a))
}

# ---------- base: sRGB lineal, redondeo ----------

fn _lin(u: f64) -> f64 {
    if u <= 0.04045 {
        return u / 12.92
    }
    return pow((u + 0.055) / 1.055, 2.4)
}

fn _gam(u: f64) -> f64 {
    if u <= 0.0031308 {
        return 12.92 * u
    }
    return 1.055 * pow(u, 1.0 / 2.4) - 0.055
}

fn _cbrt(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0 - pow(0.0 - x, 1.0 / 3.0)
    }
    return pow(x, 1.0 / 3.0)
}

fn _uno(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0
    }
    if x > 1.0 {
        return 1.0
    }
    return x
}

# 0..1 a 0..255, redondeando al más cercano (la mitad hacia arriba).
fn _a_byte(x: f64) -> i32 {
    return to_i32(floor(_uno(x) * 255.0 + 0.5))
}

fn _r(c: i32) -> f64 {
    return to_f64(canal_r(c)) / 255.0
}

fn _g(c: i32) -> f64 {
    return to_f64(canal_g(c)) / 255.0
}

fn _b(c: i32) -> f64 {
    return to_f64(canal_b(c)) / 255.0
}

# Un color a partir de rojo, verde y azul de 0 a 1 (con el alfa de `a`).
fn _de_f(r: f64, g: f64, b: f64, a: i32) -> i32 {
    return rgba(_a_byte(r), _a_byte(g), _a_byte(b), a)
}

# ---------- HSV y HSL ----------

struct Hsv {
    h: f64
    s: f64
    v: f64
}

struct Hsl {
    h: f64
    s: f64
    l: f64
}

fn _modulo360(h: f64) -> f64 {
    let mut x = h - 360.0 * floor(h / 360.0)
    if x >= 360.0 {
        x = 0.0
    }
    return x
}

# El tono, en grados, de un color con esos canales (0 a 1), y el máximo y el mínimo.
fn _tono(r: f64, g: f64, b: f64, mx: f64, mn: f64) -> f64 {
    let d = mx - mn
    if d == 0.0 {
        return 0.0
    }
    let mut h = 0.0
    if mx == r {
        h = (g - b) / d
    } else {
        if mx == g {
            h = 2.0 + (b - r) / d
        } else {
            h = 4.0 + (r - g) / d
        }
    }
    return _modulo360(h * 60.0)
}

# Tono (0 a 360), saturación y valor (0 a 1), como colorsys.rgb_to_hsv.
fn a_hsv(c: i32) -> Hsv {
    let r = _r(c)
    let g = _g(c)
    let b = _b(c)
    let mx = max(r, max(g, b))
    let mn = min(r, min(g, b))
    let s = if mx == 0.0 { 0.0 } else { (mx - mn) / mx }
    return Hsv { h: _tono(r, g, b, mx, mn), s: s, v: mx }
}

# De tono (en grados, cualquier valor: da la vuelta), saturación y valor (0 a 1) a colores.
fn de_hsv(h: f64, s: f64, v: f64) -> i32 {
    return de_hsv_a(h, s, v, 255)
}

fn de_hsv_a(h: f64, s: f64, v: f64, a: i32) -> i32 {
    let ss = _uno(s)
    let vv = _uno(v)
    let hh = _modulo360(h) / 60.0
    let i = floor(hh)
    let f = hh - i
    let p = vv * (1.0 - ss)
    let q = vv * (1.0 - ss * f)
    let t = vv * (1.0 - ss * (1.0 - f))
    let k = to_i32(i) % 6
    if k == 0 {
        return _de_f(vv, t, p, a)
    }
    if k == 1 {
        return _de_f(q, vv, p, a)
    }
    if k == 2 {
        return _de_f(p, vv, t, a)
    }
    if k == 3 {
        return _de_f(p, q, vv, a)
    }
    if k == 4 {
        return _de_f(t, p, vv, a)
    }
    return _de_f(vv, p, q, a)
}

# Tono (0 a 360), saturación y luz (0 a 1), como colorsys.rgb_to_hls.
fn a_hsl(c: i32) -> Hsl {
    let r = _r(c)
    let g = _g(c)
    let b = _b(c)
    let mx = max(r, max(g, b))
    let mn = min(r, min(g, b))
    let l = (mx + mn) / 2.0
    let d = mx - mn
    let mut s = 0.0
    if d != 0.0 {
        if l <= 0.5 {
            s = d / (mx + mn)
        } else {
            s = d / (2.0 - mx - mn)
        }
    }
    return Hsl { h: _tono(r, g, b, mx, mn), s: s, l: l }
}

fn _hsl_valor(m1: f64, m2: f64, h: f64) -> f64 {
    let x = h - floor(h)
    if x < 1.0 / 6.0 {
        return m1 + (m2 - m1) * x * 6.0
    }
    if x < 0.5 {
        return m2
    }
    if x < 2.0 / 3.0 {
        return m1 + (m2 - m1) * (2.0 / 3.0 - x) * 6.0
    }
    return m1
}

fn de_hsl(h: f64, s: f64, l: f64) -> i32 {
    return de_hsl_a(h, s, l, 255)
}

fn de_hsl_a(h: f64, s: f64, l: f64, a: i32) -> i32 {
    let ss = _uno(s)
    let ll = _uno(l)
    if ss == 0.0 {
        return _de_f(ll, ll, ll, a)
    }
    let m2 = if ll <= 0.5 { ll * (1.0 + ss) } else { ll + ss - ll * ss }
    let m1 = 2.0 * ll - m2
    let t = _modulo360(h) / 360.0
    return _de_f(_hsl_valor(m1, m2, t + 1.0 / 3.0), _hsl_valor(m1, m2, t), _hsl_valor(m1, m2, t - 1.0 / 3.0), a)
}

# ---------- CIE Lab (D65, 2°) ----------

struct Lab {
    l: f64
    a: f64
    b: f64
}

fn _xyz_x(r: f64, g: f64, b: f64) -> f64 {
    return 0.412453 * r + 0.35758 * g + 0.180423 * b
}

fn _xyz_y(r: f64, g: f64, b: f64) -> f64 {
    return 0.212671 * r + 0.71516 * g + 0.072169 * b
}

fn _xyz_z(r: f64, g: f64, b: f64) -> f64 {
    return 0.019334 * r + 0.119193 * g + 0.950227 * b
}

fn _f_lab(t: f64) -> f64 {
    if t > 0.008856 {
        return _cbrt(t)
    }
    return 7.787 * t + 16.0 / 116.0
}

# L (0 a 100), a y b, como skimage.colores.rgb2lab.
fn a_lab(c: i32) -> Lab {
    let r = _lin(_r(c))
    let g = _lin(_g(c))
    let b = _lin(_b(c))
    let x = _f_lab(_xyz_x(r, g, b) / 0.95047)
    let y = _f_lab(_xyz_y(r, g, b))
    let z = _f_lab(_xyz_z(r, g, b) / 1.08883)
    return Lab { l: 116.0 * y - 16.0, a: 500.0 * (x - y), b: 200.0 * (y - z) }
}

fn _g_lab(t: f64) -> f64 {
    if t > 0.2068966 {
        return t * t * t
    }
    return (t - 16.0 / 116.0) / 7.787
}

# Lo contrario (lo que no cabe en sRGB se recorta), como skimage.colores.lab2rgb.
fn de_lab(l: f64, a: f64, b: f64) -> i32 {
    return de_lab_a(l, a, b, 255)
}

fn de_lab_a(l: f64, a: f64, b: f64, alfa: i32) -> i32 {
    let fy = (l + 16.0) / 116.0
    let fx = a / 500.0 + fy
    let mut fz = fy - b / 200.0
    if fz < 0.0 {
        fz = 0.0
    }
    let x = _g_lab(fx) * 0.95047
    let y = _g_lab(fy)
    let z = _g_lab(fz) * 1.08883
    let r = 3.2404813432005266 * x - 1.5371515162713183 * y - 0.4985363261688878 * z
    let g = 0.0 - 0.9692549499965682 * x + 1.8759900014898907 * y + 0.04155592655829284 * z
    let bb = 0.055646639135177166 * x - 0.20404133836651123 * y + 1.0573110696453443 * z
    return _de_f(_gam(_uno(r)), _gam(_uno(g)), _gam(_uno(bb)), alfa)
}

# ---------- Oklab ----------

struct Oklab {
    l: f64
    a: f64
    b: f64
}

# L (0 a 1), a y b (Björn Ottosson, 2020): una distancia entre colores casi pareja y
# degradados sin los grises sucios de mezclar en sRGB.
fn a_oklab(c: i32) -> Oklab {
    let r = _lin(_r(c))
    let g = _lin(_g(c))
    let b = _lin(_b(c))
    let l = _cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b)
    let m = _cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b)
    let s = _cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b)
    return Oklab {
        l: 0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s,
        a: 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s,
        b: 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s
    }
}

fn de_oklab(l: f64, a: f64, b: f64) -> i32 {
    return de_oklab_a(l, a, b, 255)
}

fn de_oklab_a(l: f64, a: f64, b: f64, alfa: i32) -> i32 {
    let l_ = l + 0.3963377774 * a + 0.2158037573 * b
    let m_ = l - 0.1055613458 * a - 0.0638541728 * b
    let s_ = l - 0.0894841775 * a - 1.291485548 * b
    let ll = l_ * l_ * l_
    let mm = m_ * m_ * m_
    let ss = s_ * s_ * s_
    let r = 4.0767416621 * ll - 3.3077115913 * mm + 0.2309699292 * ss
    let g = 0.0 - 1.2684380046 * ll + 2.6097574011 * mm - 0.3413193965 * ss
    let bb = 0.0 - 0.0041960863 * ll - 0.7034186147 * mm + 1.707614701 * ss
    return _de_f(_gam(_uno(r)), _gam(_uno(g)), _gam(_uno(bb)), alfa)
}

# ---------- operaciones ----------

fn _mezcla_byte(a: i32, b: i32, t: f64) -> i32 {
    return to_i32(floor(to_f64(a) + (to_f64(b) - to_f64(a)) * t + 0.5))
}

# Mezcla `a` con `b`: t = 0 da a, t = 1 da b (en sRGB, canal por canal, alfa incluido).
fn mezclar(a: i32, b: i32, t: f64) -> i32 {
    let u = _uno(t)
    return rgba(_mezcla_byte(canal_r(a), canal_r(b), u), _mezcla_byte(canal_g(a), canal_g(b), u), _mezcla_byte(canal_b(a), canal_b(b), u), _mezcla_byte(canal_a(a), canal_a(b), u))
}

# Lo mismo en Oklab: el degradado pasa por colores parejos en luz y sin oscurecerse
# a mitad de camino.
fn mezclar_oklab(a: i32, b: i32, t: f64) -> i32 {
    let u = _uno(t)
    let x = a_oklab(a)
    let y = a_oklab(b)
    return de_oklab_a(x.l + (y.l - x.l) * u, x.a + (y.a - x.a) * u, x.b + (y.b - x.b) * u, _mezcla_byte(canal_a(a), canal_a(b), u))
}

# Mezcla con blanco: t de 0 (igual) a 1 (blanco).
fn aclarar(c: i32, t: f64) -> i32 {
    return mezclar(c, rgba(255, 255, 255, canal_a(c)), t)
}

# Mezcla con negro: t de 0 (igual) a 1 (negro).
fn oscurecer(c: i32, t: f64) -> i32 {
    return mezclar(c, rgba(0, 0, 0, canal_a(c)), t)
}

# Multiplica la saturación (en HSL) por `factor` (0 apaga, 2 duplica, con tope en 1).
fn saturar(c: i32, factor: f64) -> i32 {
    let x = a_hsl(c)
    return de_hsl_a(x.h, x.s * factor, x.l, canal_a(c))
}

# Gira el tono esos grados (en HSL).
fn girar_tono(c: i32, grados: f64) -> i32 {
    let x = a_hsl(c)
    return de_hsl_a(x.h + grados, x.s, x.l, canal_a(c))
}

fn complementario(c: i32) -> i32 {
    return girar_tono(c, 180.0)
}

# El negativo: 255 menos cada canal (el alfa queda).
fn invertir(c: i32) -> i32 {
    return rgba(255 - canal_r(c), 255 - canal_g(c), 255 - canal_b(c), canal_a(c))
}

# ---------- luminancia, contraste, diferencias ----------

# La luminancia relativa de WCAG 2: 0 (negro) a 1 (blanco).
fn luminancia(c: i32) -> f64 {
    return 0.2126 * _lin(_r(c)) + 0.7152 * _lin(_g(c)) + 0.0722 * _lin(_b(c))
}

# El gris con la misma luminancia (opaco no: conserva el alfa).
fn gris(c: i32) -> i32 {
    let y = _a_byte(_gam(luminancia(c)))
    return rgba(y, y, y, canal_a(c))
}

# La relación de contraste de WCAG entre dos colores: de 1 (iguales) a 21 (negro sobre
# blanco). 4.5 es el mínimo para texto normal (AA) y 7, para AAA.
fn contraste(a: i32, b: i32) -> f64 {
    let la = luminancia(a)
    let lb = luminancia(b)
    let hi = max(la, lb)
    let lo = min(la, lb)
    return (hi + 0.05) / (lo + 0.05)
}

# Negro o blanco, el que se lee mejor sobre ese fondo.
fn texto_sobre(fondo: i32) -> i32 {
    let n = rgb(0, 0, 0)
    let b = rgb(255, 255, 255)
    if contraste(fondo, n) >= contraste(fondo, b) {
        return n
    }
    return b
}

fn _rad(g: f64) -> f64 {
    return g * mate_pi() / 180.0
}

fn mate_pi() -> f64 {
    return 3.141592653589793
}

fn _grados(r: f64) -> f64 {
    return r * 180.0 / mate_pi()
}

# El ángulo de (b, a) en grados de 0 a 360 (atan2 sale de atan).
fn _angulo(y: f64, x: f64) -> f64 {
    if x == 0.0 and y == 0.0 {
        return 0.0
    }
    let mut r = 0.0
    if x > 0.0 {
        r = atan(y / x)
    } else {
        if x < 0.0 {
            if y >= 0.0 {
                r = atan(y / x) + mate_pi()
            } else {
                r = atan(y / x) - mate_pi()
            }
        } else {
            if y > 0.0 {
                r = mate_pi() / 2.0
            } else {
                r = 0.0 - mate_pi() / 2.0
            }
        }
    }
    let mut g = _grados(r)
    if g < 0.0 {
        g = g + 360.0
    }
    return g
}

# La diferencia CIEDE2000 (ΔE) entre dos colores: 0 son iguales, 1 casi no se nota,
# más de 5 se distinguen a simple vista (skimage.colores.deltaE_ciede2000).
fn delta_e(a: i32, b: i32) -> f64 {
    let x = a_lab(a)
    let y = a_lab(b)
    let c1 = sqrt(x.a * x.a + x.b * x.b)
    let c2 = sqrt(y.a * y.a + y.b * y.b)
    let cm = (c1 + c2) / 2.0
    let cm7 = pow(cm, 7.0)
    let g = 0.5 * (1.0 - sqrt(cm7 / (cm7 + pow(25.0, 7.0))))
    let a1 = (1.0 + g) * x.a
    let a2 = (1.0 + g) * y.a
    let cp1 = sqrt(a1 * a1 + x.b * x.b)
    let cp2 = sqrt(a2 * a2 + y.b * y.b)
    let hp1 = _angulo(x.b, a1)
    let hp2 = _angulo(y.b, a2)
    let dl = y.l - x.l
    let dc = cp2 - cp1
    let mut dh = 0.0
    if cp1 * cp2 != 0.0 {
        dh = hp2 - hp1
        if dh > 180.0 {
            dh = dh - 360.0
        }
        if dh < 0.0 - 180.0 {
            dh = dh + 360.0
        }
    }
    let dhh = 2.0 * sqrt(cp1 * cp2) * sin(_rad(dh / 2.0))
    let lm = (x.l + y.l) / 2.0
    let cpm = (cp1 + cp2) / 2.0
    let mut hm = hp1 + hp2
    if cp1 * cp2 != 0.0 {
        if abs(hp1 - hp2) > 180.0 {
            if hp1 + hp2 < 360.0 {
                hm = hp1 + hp2 + 360.0
            } else {
                hm = hp1 + hp2 - 360.0
            }
        }
        hm = hm / 2.0
    }
    let t = 1.0 - 0.17 * cos(_rad(hm - 30.0)) + 0.24 * cos(_rad(2.0 * hm)) + 0.32 * cos(_rad(3.0 * hm + 6.0)) - 0.2 * cos(_rad(4.0 * hm - 63.0))
    let dtheta = 30.0 * exp(0.0 - ((hm - 275.0) / 25.0) * ((hm - 275.0) / 25.0))
    let cpm7 = pow(cpm, 7.0)
    let rc = 2.0 * sqrt(cpm7 / (cpm7 + pow(25.0, 7.0)))
    let sl = 1.0 + 0.015 * (lm - 50.0) * (lm - 50.0) / sqrt(20.0 + (lm - 50.0) * (lm - 50.0))
    let sc = 1.0 + 0.045 * cpm
    let sh = 1.0 + 0.015 * cpm * t
    let rt = 0.0 - sin(_rad(2.0 * dtheta)) * rc
    let el = dl / sl
    let ec = dc / sc
    let eh = dhh / sh
    return sqrt(el * el + ec * ec + eh * eh + rt * ec * eh)
}

# ---------- daltonismo ----------

# Cómo ve el color alguien con esa deficiencia (modelo de Machado, Oliveira y Fernandes
# 2009, sobre sRGB lineal). `tipo`: "protanopia" (sin rojo), "deuteranopia" (sin verde),
# "tritanopia" (sin azul) o "acromatopsia" (solo luz). `severidad` de 0 (ve normal) a 1
# (ausencia total); los valores de en medio mezclan las matrices en línea recta. Err si
# el tipo no existe.
fn simular(c: i32, tipo: str, severidad: f64) -> Result<i32> {
    let r = _lin(_r(c))
    let g = _lin(_g(c))
    let b = _lin(_b(c))
    let k = _uno(severidad)
    let mut m00 = 1.0
    let mut m01 = 0.0
    let mut m02 = 0.0
    let mut m10 = 0.0
    let mut m11 = 1.0
    let mut m12 = 0.0
    let mut m20 = 0.0
    let mut m21 = 0.0
    let mut m22 = 1.0
    if tipo == "protanopia" {
        m00 = 0.152286
        m01 = 1.052583
        m02 = 0.0 - 0.204868
        m10 = 0.114503
        m11 = 0.786281
        m12 = 0.099216
        m20 = 0.0 - 0.003882
        m21 = 0.0 - 0.048116
        m22 = 1.051998
    } else {
        if tipo == "deuteranopia" {
            m00 = 0.367322
            m01 = 0.860646
            m02 = 0.0 - 0.227968
            m10 = 0.280085
            m11 = 0.672501
            m12 = 0.047413
            m20 = 0.0 - 0.01182
            m21 = 0.04294
            m22 = 0.968881
        } else {
            if tipo == "tritanopia" {
                m00 = 1.255528
                m01 = 0.0 - 0.076749
                m02 = 0.0 - 0.178779
                m10 = 0.0 - 0.078411
                m11 = 0.930809
                m12 = 0.147602
                m20 = 0.004733
                m21 = 0.691367
                m22 = 0.3039
            } else {
                if tipo == "acromatopsia" {
                    m00 = 0.2126
                    m01 = 0.7152
                    m02 = 0.0722
                    m10 = 0.2126
                    m11 = 0.7152
                    m12 = 0.0722
                    m20 = 0.2126
                    m21 = 0.7152
                    m22 = 0.0722
                } else {
                    return Err("color: tipo de daltonismo desconocido '" + tipo + "' (protanopia, deuteranopia, tritanopia o acromatopsia)")
                }
            }
        }
    }
    let a00 = 1.0 + k * (m00 - 1.0)
    let a01 = k * m01
    let a02 = k * m02
    let a10 = k * m10
    let a11 = 1.0 + k * (m11 - 1.0)
    let a12 = k * m12
    let a20 = k * m20
    let a21 = k * m21
    let a22 = 1.0 + k * (m22 - 1.0)
    let nr = a00 * r + a01 * g + a02 * b
    let ng = a10 * r + a11 * g + a12 * b
    let nb = a20 * r + a21 * g + a22 * b
    return Ok(_de_f(_gam(_uno(nr)), _gam(_uno(ng)), _gam(_uno(nb)), canal_a(c)))
}

# ---------- degradados ----------

# Una lista de colores (un Vec adentro de un struct, para poder prestarlo).
struct Lista {
    v: Vec<i32>
}

fn lista() -> Lista {
    let v: Vec<i32> = vec_new()
    return Lista { v: v }
}

fn lista_agregar(l: Lista, c: i32) {
    l.v.push(c)
}

fn lista_largo(l: Lista) -> i32 {
    return l.v.len()
}

fn lista_color(l: Lista, i: i32) -> i32 {
    return l.v.get(i).unwrap_or(0)
}

# El color en la posición t (0 a 1) de un degradado con esos colores repartidos parejo.
# Con `oklab` mezcla en Oklab (mejor para el ojo); si no, en sRGB. Con la lista vacía,
# negro.
fn degradado(l: Lista, t: f64, oklab: bool) -> i32 {
    let n = l.v.len()
    if n == 0 {
        return rgb(0, 0, 0)
    }
    if n == 1 {
        return l.v.get(0).unwrap_or(0)
    }
    let u = _uno(t) * to_f64(n - 1)
    let mut i = to_i32(floor(u))
    if i >= n - 1 {
        i = n - 2
    }
    let f = u - to_f64(i)
    let a = l.v.get(i).unwrap_or(0)
    let b = l.v.get(i + 1).unwrap_or(0)
    if oklab {
        return mezclar_oklab(a, b, f)
    }
    return mezclar(a, b, f)
}

# El color i de n colores bien repartidos en el círculo de tonos de Oklab, con la misma
# luz y el mismo croma: n colores distintos para n series de datos. n y los índices
# arrancan en 0 y dan la vuelta (i % n).
fn paleta_n(n: i32, i: i32) -> i32 {
    if n < 1 {
        return rgb(0, 0, 0)
    }
    let k = i % n
    let h = _rad(360.0 * to_f64(k) / to_f64(n) + 29.0)
    return de_oklab(0.72, 0.13 * cos(h), 0.13 * sin(h))
}

# ---------- nombres de CSS ----------

# Un color de la tabla de nombres de CSS (148), sin importar mayúsculas. Err si no existe.
fn con_nombre(nombre: str) -> Result<i32> {
    let v = _css_busca(texto.minusculas(texto.recortar(nombre)))
    if v < 0 {
        return Err("color: no conozco el color '" + nombre + "'")
    }
    return Ok((255 << 24) | v)
}

fn cantidad_nombres() -> i32 {
    return 148
}

# El nombre número i (de 0 a 147, en orden alfabético).
fn nombre_en(i: i32) -> str {
    return _css_nombre(i)
}

fn color_en(i: i32) -> i32 {
    return (255 << 24) | _css_valor(i)
}

# El nombre de CSS del color más parecido (la menor diferencia CIEDE2000).
fn nombre_mas_cercano(c: i32) -> str {
    let mut mejor = 0
    let mut dmin = 1000000.0
    for i in 0..148 {
        let d = delta_e(c, color_en(i))
        if d < dmin {
            dmin = d
            mejor = i
        }
    }
    return _css_nombre(mejor)
}

# ---------- paletas y mapas ----------

struct Paleta {
    v: Vec<i32>
}

struct Mapa {
    v: Vec<i32>
}

# Una paleta de colores distintos por nombre: "tab10", "tab20", "set1", "set2", "set3",
# "dark2", "paired", "accent", "pastel1", "pastel2" u "okabe_ito". Err si no existe.
fn paleta(nombre: str) -> Result<Paleta> {
    let v = _cat(texto.minusculas(nombre))
    if v.len() == 0 {
        return Err("color: no conozco la paleta '" + nombre + "'")
    }
    return Ok(Paleta { v: v })
}

fn paleta_largo(p: Paleta) -> i32 {
    return p.v.len()
}

# El color i de la paleta (da la vuelta cuando i pasa del largo).
fn paleta_color(p: Paleta, i: i32) -> i32 {
    let n = p.v.len()
    if n == 0 {
        return rgb(0, 0, 0)
    }
    let mut k = i % n
    if k < 0 {
        k = k + n
    }
    return (255 << 24) | p.v.get(k).unwrap_or(0)
}

fn cantidad_paletas() -> i32 {
    return 11
}

fn nombre_paleta(i: i32) -> str {
    return _cat_nombre(i)
}

# Un mapa de color continuo de 256 pasos por nombre: "viridis", "magma", "inferno",
# "plasma", "cividis", "turbo", "coolwarm", "rdbu", "spectral", "ylgnbu", "greys" o
# "hot". Err si no existe.
fn mapa(nombre: str) -> Result<Mapa> {
    let v = _lut(texto.minusculas(nombre))
    if v.len() == 0 {
        return Err("color: no conozco el mapa de color '" + nombre + "'")
    }
    return Ok(Mapa { v: v })
}

# El color del mapa en t (de 0 a 1; fuera de ese rango se recorta), con el mismo paso
# que matplotlib: el casillero int(t * 256).
fn mapa_en(m: Mapa, t: f64) -> i32 {
    let n = m.v.len()
    if n == 0 {
        return rgb(0, 0, 0)
    }
    let mut i = to_i32(floor(_uno(t) * to_f64(n)))
    if i >= n {
        i = n - 1
    }
    return (255 << 24) | m.v.get(i).unwrap_or(0)
}

fn cantidad_mapas() -> i32 {
    return 12
}

fn nombre_mapa(i: i32) -> str {
    return _lut_nombre(i)
}

