fn _lut(nombre: str) -> Vec<i32> {
    if nombre == "viridis" {
        return _lut_viridis()
    }
    if nombre == "magma" {
        return _lut_magma()
    }
    if nombre == "inferno" {
        return _lut_inferno()
    }
    if nombre == "plasma" {
        return _lut_plasma()
    }
    if nombre == "cividis" {
        return _lut_cividis()
    }
    if nombre == "turbo" {
        return _lut_turbo()
    }
    if nombre == "coolwarm" {
        return _lut_coolwarm()
    }
    if nombre == "rdbu" {
        return _lut_rdbu()
    }
    if nombre == "spectral" {
        return _lut_spectral()
    }
    if nombre == "ylgnbu" {
        return _lut_ylgnbu()
    }
    if nombre == "greys" {
        return _lut_greys()
    }
    if nombre == "hot" {
        return _lut_hot()
    }
    let vacio: Vec<i32> = vec_new()
    return vacio
}

fn _lut_nombre(i: i32) -> str {
    if i == 0 {
        return "viridis"
    }
    if i == 1 {
        return "magma"
    }
    if i == 2 {
        return "inferno"
    }
    if i == 3 {
        return "plasma"
    }
    if i == 4 {
        return "cividis"
    }
    if i == 5 {
        return "turbo"
    }
    if i == 6 {
        return "coolwarm"
    }
    if i == 7 {
        return "rdbu"
    }
    if i == 8 {
        return "spectral"
    }
    if i == 9 {
        return "ylgnbu"
    }
    if i == 10 {
        return "greys"
    }
    if i == 11 {
        return "hot"
    }
    return ""
}

