fn _cat(nombre: str) -> Vec<i32> {
    if nombre == "tab10" {
        return _cat_tab10()
    }
    if nombre == "tab20" {
        return _cat_tab20()
    }
    if nombre == "set1" {
        return _cat_set1()
    }
    if nombre == "set2" {
        return _cat_set2()
    }
    if nombre == "set3" {
        return _cat_set3()
    }
    if nombre == "dark2" {
        return _cat_dark2()
    }
    if nombre == "paired" {
        return _cat_paired()
    }
    if nombre == "accent" {
        return _cat_accent()
    }
    if nombre == "pastel1" {
        return _cat_pastel1()
    }
    if nombre == "pastel2" {
        return _cat_pastel2()
    }
    if nombre == "okabe_ito" {
        return _cat_okabe_ito()
    }
    let vacio: Vec<i32> = vec_new()
    return vacio
}

fn _cat_nombre(i: i32) -> str {
    if i == 0 {
        return "tab10"
    }
    if i == 1 {
        return "tab20"
    }
    if i == 2 {
        return "set1"
    }
    if i == 3 {
        return "set2"
    }
    if i == 4 {
        return "set3"
    }
    if i == 5 {
        return "dark2"
    }
    if i == 6 {
        return "paired"
    }
    if i == 7 {
        return "accent"
    }
    if i == 8 {
        return "pastel1"
    }
    if i == 9 {
        return "pastel2"
    }
    if i == 10 {
        return "okabe_ito"
    }
    return ""
}

