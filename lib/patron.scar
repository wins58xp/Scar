# lib/patron.scar: expresiones regulares (use "patron").
#
#   use "patron"
#
#   match patron.compilar("(\\d+)-(\\d+)") {
#       Ok(p) => {
#           let m = patron.buscar(p, "rango 10-25 y 3-4")
#           if patron.hay(m) {
#               print(patron.grupo(m, 1), patron.grupo(m, 2))      # 10 25
#           }
#           print(patron.reemplazar_texto(p, "10-25", "x"))        # x
#           match patron.reemplazar(p, "10-25 3-4", "\\2:\\1") {
#               Ok(s) => print(s)                                  # 25:10 4:3
#               Err(e) => print(e)
#           }
#       }
#       Err(e) => print(e)
#   }
#
# Escrita entera en SCAR. Es un motor al
# estilo Thompson / Pike: el patrón se compila a un programa de instrucciones y se corre
# con una "máquina virtual de hilos" que avanza todos los caminos posibles a la vez, un
# carácter por vez. Por eso el tiempo es siempre proporcional a (largo del texto) x (largo
# del patrón): nunca hay el retroceso exponencial de `(a+)+b` contra "aaaa...a". Los hilos
# van en orden de prioridad, así que da lo mismo que el módulo `re` de Python: el que
# empieza más a la izquierda, y entre los que empiezan igual el primero que hubiera
# probado un motor con retroceso (el `*` es codicioso, el `*?` perezoso, en `a|ab` gana `a`).
#
# Sintaxis aceptada (la de `re`):
#   .  ^  $  \A  \Z  \b  \B   clases  [abc] [a-z] [^0-9] con \d \w \s adentro
#   \d \D \w \W \s \S         (Unicode, como `re`: \w son las letras y cifras de cualquier alfabeto)
#   * + ? {n} {n,} {,m} {n,m} y sus versiones perezosas (*? +? ?? {n,m}?)
#   | (alternativa)   ( ) grupo que captura   (?: ) grupo que no captura   (?P<nombre> )
#   (?i) (?m) (?s) al principio del patrón, o (?i: ) (?-i: ) en un trozo
#   escapes \n \t \r \f \v \a \xhh \uhhhh \Uhhhhhhhh \0 \012 y cualquier signo escapado
# No acepta (y avisa con un Err claro, no se queda callada): referencias hacia atrás (\1,
# (?P=n)), mirar adelante / atrás ((?=) (?!) (?<=) (?<!)), grupos atómicos y cuantificadores
# posesivos, condicionales (?(1)..), \N{nombre}, ni las banderas a, u, L, x. Esas cosas no
# se pueden hacer en tiempo lineal (o no son regulares); si las necesitas, se dividen en dos
# búsquedas.
#
# Diferencias a propósito con `re`:
#   - \B también calza en el texto vacío (en Python < 3.14 no; desde la 3.14 sí).
#   - Las mayúsculas/minúsculas con (?i) se igualan en ASCII, Latin-1, Latin extendido A,
#     griego y cirílico (no en el resto del Unicode, ni las rarezas como la ß o la K del kelvin).
#   - Las posiciones son de caracteres (puntos de código), igual que en Python.
#   - Un grupo que no participó da "" en `grupo` (en Python da None); `hay_grupo` lo distingue.
#
# Probada contra `re` de Python.

use "texto"

struct Patron {
    fuente: str
    ngrupos: i32
    nregs: i32
    nombres: Vec<str>
    op: Vec<i32>
    ax: Vec<i32>
    ay: Vec<i32>
    cl_ini: Vec<i32>
    cl_fin: Vec<i32>
    cl_neg: Vec<i32>
    it_tipo: Vec<i32>
    it_a: Vec<i32>
    it_b: Vec<i32>
    tw: Vec<i32>
    td: Vec<i32>
}

# Una búsqueda que calzó (o no): hay() lo dice. pos tiene [inicio0, fin0, inicio1, fin1...]
# en caracteres, con -1 en los grupos que no participaron.
struct Coincidencia {
    ok: bool
    pos: Vec<i32>
    s: str
}

struct Texto {
    c: Vec<i32>
    s: str
}

# ---------------------------------------------------------------------------
# Mayúsculas y minúsculas (las letras que cubre la lib, ver arriba)
# ---------------------------------------------------------------------------

fn _baja(c: i32) -> i32 {
    if c < 65 {
        return c
    }
    if c <= 90 {
        return c + 32
    }
    if c < 192 {
        return c
    }
    if c <= 222 {
        if c == 215 {
            return c
        }
        return c + 32
    }
    if c < 256 {
        return c
    }
    if c <= 383 {
        if c == 304 or c == 305 or c == 312 or c == 329 or c == 383 {
            return c
        }
        if c == 376 {
            return 255
        }
        if (c <= 311 or (c >= 330 and c <= 375)) and c % 2 == 0 {
            return c + 1
        }
        if ((c >= 313 and c <= 328) or (c >= 377 and c <= 382)) and c % 2 == 1 {
            return c + 1
        }
        return c
    }
    if c >= 913 and c <= 937 {
        if c == 930 {
            return c
        }
        return c + 32
    }
    if c >= 1024 and c <= 1039 {
        return c + 80
    }
    if c >= 1040 and c <= 1071 {
        return c + 32
    }
    return c
}

fn _sube(c: i32) -> i32 {
    if c < 97 {
        return c
    }
    if c <= 122 {
        return c - 32
    }
    if c < 224 {
        return c
    }
    if c <= 254 {
        if c == 247 {
            return c
        }
        return c - 32
    }
    if c == 255 {
        return 376
    }
    if c < 257 {
        return c
    }
    if c <= 383 {
        if c == 305 or c == 312 or c == 329 or c == 383 {
            return c
        }
        if (c <= 311 or (c >= 330 and c <= 375)) and c % 2 == 1 {
            return c - 1
        }
        if ((c >= 313 and c <= 328) or (c >= 377 and c <= 382)) and c % 2 == 0 {
            return c - 1
        }
        return c
    }
    if c >= 945 and c <= 969 {
        if c == 962 {
            return c
        }
        return c - 32
    }
    if c >= 1104 and c <= 1119 {
        return c - 80
    }
    if c >= 1072 and c <= 1103 {
        return c - 32
    }
    return c
}

# ---------------------------------------------------------------------------
# Tablas de Unicode: \w (str.isalnum), \d (str.isdecimal). Se decodifican al compilar
# un patrón que las usa. Los números van como diferencias en hexadecimal.
# ---------------------------------------------------------------------------

fn _decodificar(t: str) -> Vec<i32> {
    let r: Vec<i32> = vec_new()
    let n = t.len()
    let mut acum = 0
    let mut v = 0
    let mut en_numero = false
    let mut i = 0
    while i < n {
        let c = ord(t[i])
        if c == 32 {
            if en_numero {
                acum = acum + v
                r.push(acum)
                v = 0
                en_numero = false
            }
        } else {
            let d = if c >= 97 { c - 87 } else { c - 48 }
            v = v * 16 + d
            en_numero = true
        }
        i = i + 1
    }
    if en_numero {
        acum = acum + v
        r.push(acum)
    }
    return r
}

