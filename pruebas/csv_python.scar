# lib/csv contra Python: lo corre pruebas/test_csv_python.py. Lee "casos.txt"
# (en la carpeta donde corre): cada línea es una letra del separador (C coma,
# S punto y coma, T tabulador, P barra vertical), un espacio y el texto del CSV
# en hexadecimal (los bytes UTF-8). Por cada caso escribe las filas leídas
# ("R" y cada celda en hexadecimal) y el CSV que sale de escribir la tabla ("W").

use "csv"

fn hex(s: str) -> str {
    let v = csv.bytes_de(s)
    let digitos = "0123456789abcdef"
    let mut t = ""
    for i in 0..v.len() {
        match v.get(i) {
            Some(b) => { t = t + digitos[(b >> 4) & 15] + digitos[b & 15] }
            None => {}
        }
    }
    return t
}

fn valor_hex(c: i32) -> i32 {
    if c >= 97 {
        return c - 87
    }
    return c - 48
}

# Los bytes que describe un texto en hexadecimal, desde la posición `desde`.
fn de_hex(linea: Vec<i32>, desde: i32) -> Vec<i32> {
    let r: Vec<i32> = vec_new()
    let mut i = desde
    while i + 1 < linea.len() {
        let a = valor_hex(linea.get(i).unwrap_or(48))
        let b = valor_hex(linea.get(i + 1).unwrap_or(48))
        r.push(a * 16 + b)
        i = i + 2
    }
    return r
}

fn separador_de(letra: i32) -> str {
    if letra == 83 {
        return ";"
    }
    if letra == 84 {
        return "\t"
    }
    if letra == 80 {
        return "|"
    }
    return ","
}

fn caso(linea: Vec<i32>) -> Result<i32> {
    let sep = separador_de(linea.get(0).unwrap_or(67))
    let cuerpo = de_hex(linea, 2)
    let t = csv.analizar(cuerpo, sep)?
    print("N", csv.filas(t))
    for f in 0..csv.filas(t) {
        let mut fila = "R"
        for c in 0..csv.columnas(t, f) {
            fila = fila + " " + hex(csv.celda(t, f, c))
        }
        print(fila)
    }
    print("W", hex(csv.escribir(t, sep)))
    return Ok(1)
}

fn correr() -> Result<i32> {
    let todo = csv.bytes_de_archivo("casos.txt")?
    let mut linea: Vec<i32> = vec_new()
    let mut n = 0
    for i in 0..todo.len() {
        let b = todo.get(i).unwrap_or(10)
        if b == 10 {
            if linea.len() > 0 {
                let _r = caso(linea)?
                n = n + 1
            }
            linea = vec_new()
        } else {
            linea.push(b)
        }
    }
    return Ok(n)
}

fn main() {
    let r = correr()
    if r.is_err() {
        print("ERROR", r.err())
    }
}
