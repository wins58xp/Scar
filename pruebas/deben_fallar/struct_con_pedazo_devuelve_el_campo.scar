# espera: acá se mueve o se guarda en otro lado
struct Capa {
    w: Vec<f64>
    n: i32
}
fn f(params: Vec<f64>) -> Vec<f64> {
    let c = Capa { w: params[0..2], n: 1 }
    return c.w
}
fn main() {
    let p = [1.0, 2.0, 3.0]
    let x = f(p)
    p.push(4.0)
    p.push(5.0)
    p.push(6.0)
    print(x)
}
