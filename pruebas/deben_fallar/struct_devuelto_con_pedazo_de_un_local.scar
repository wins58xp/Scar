# espera: guarda un pedazo de un Vec que no llegó por un parámetro
struct Capa {
    w: Vec<f64>
    n: i32
}
fn capa(params: Vec<f64>, n: i32) -> Capa {
    return Capa { w: params[0..n], n: n }
}
fn local() -> Capa {
    let p = [1.0, 2.0, 3.0]
    return capa(p, 2)
}
fn main() {
    let c = local()
    print(c.w)
}
