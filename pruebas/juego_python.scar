# lib/juego contra una referencia en Python: lo corre pruebas/test_juego_python.py.
# Lee "casos.json" (en la carpeta donde corre) y escribe una línea por resultado, "ETIQUETA k ...":
#   R  relojes (pasos por cuadro y lo que sobra)      P  relojes con la hora del sistema (con vuelta)
#   A  animaciones                                    T  mapas escritos en texto
#   M  cuerpos que se mueven por un mapa              C  cámaras
#   E  entrada (se apretó, se soltó, está apretada)   H  hojas de sprites (también por un PNG)
#   D  dibujo de un mapa visto por una cámara
# Los números con decimales llegan como enteros (ochavos, mil por uno) para que ningún formato los toque.

use "json"
use "juego"
use "lienzo"
use "imagen"

fn n(d: json.Doc, ruta: str) -> i32 {
    return to_i32(json.entero(d, ruta))
}

fn csv_de(v: Vec<i32>) -> str {
    let mut s = ""
    for i in 0..v.len() {
        if i > 0 {
            s = s + ","
        }
        s = s + a_texto(v.get(i).unwrap_or(0))
    }
    return s
}

fn b(x: bool) -> i32 {
    if x {
        return 1
    }
    return 0
}

fn relojes(d: json.Doc) {
    for k in 0..json.largo(d, "relojes") {
        let r = "relojes." + a_texto(k)
        let reloj = juego.reloj(n(d, r + ".hz"))
        juego.reloj_maximo(reloj, n(d, r + ".maximo"))
        let mut s = ""
        for j in 0..json.largo(d, r + ".dts") {
            if j > 0 {
                s = s + ","
            }
            s = s + a_texto(juego.avanzar(reloj, n(d, r + ".dts." + a_texto(j))))
        }
        print("R " + a_texto(k) + " " + s + " " + a_texto(reloj.acum))
    }
    for k in 0..json.largo(d, "horas") {
        let r = "horas." + a_texto(k)
        let reloj = juego.reloj(n(d, r + ".hz"))
        let mut s = ""
        for j in 0..json.largo(d, r + ".t") {
            if j > 0 {
                s = s + ","
            }
            s = s + a_texto(juego.pasos(reloj, n(d, r + ".t." + a_texto(j))))
        }
        print("P " + a_texto(k) + " " + s)
    }
}

fn animaciones(d: json.Doc) {
    for k in 0..json.largo(d, "anims") {
        let r = "anims." + a_texto(k)
        let a = juego.animacion(n(d, r + ".primero"), n(d, r + ".cantidad"), n(d, r + ".ms"), n(d, r + ".modo"))
        let mut s = ""
        let mut t = ""
        for j in 0..json.largo(d, r + ".ts") {
            let ms = n(d, r + ".ts." + a_texto(j))
            if j > 0 {
                s = s + ","
                t = t + ","
            }
            s = s + a_texto(juego.cuadro(a, ms))
            t = t + a_texto(b(juego.terminada(a, ms)))
        }
        print("A " + a_texto(k) + " " + s + " " + t + " " + a_texto(juego.duracion(a)))
    }
}

fn mapa_de(d: json.Doc, r: str) -> juego.Mapa {
    let m = juego.mapa(n(d, r + ".cols"), n(d, r + ".filas"), n(d, r + ".tam"))
    for i in 0..m.cols * m.filas {
        juego.poner(m, i % m.cols, i / m.cols, n(d, r + ".celdas." + a_texto(i)))
    }
    juego.mapa_fuera(m, n(d, r + ".fuera"))
    return m
}

fn textos(d: json.Doc) {
    for k in 0..json.largo(d, "textos") {
        let r = "textos." + a_texto(k)
        let m = juego.mapa_texto(n(d, r + ".tam"), json.texto(d, r + ".s"))
        print("T " + a_texto(k) + " " + a_texto(m.cols) + " " + a_texto(m.filas) + " " + csv_de(m.celdas))
    }
}

fn cuerpos(d: json.Doc) {
    for k in 0..json.largo(d, "mapas") {
        let r = "mapas." + a_texto(k)
        let m = mapa_de(d, r)
        for q in 0..json.largo(d, r + ".cuerpos") {
            let rc = r + ".cuerpos." + a_texto(q)
            let c = juego.cuerpo(n(d, rc + ".x"), n(d, rc + ".y"), n(d, rc + ".w"), n(d, rc + ".h"))
            for j in 0..json.largo(d, rc + ".movs") {
                let rm = rc + ".movs." + a_texto(j)
                c.vx = 1.0
                c.vy = 1.0
                juego.mover(m, c, to_f64(n(d, rm + ".0")) / 8.0, to_f64(n(d, rm + ".1")) / 8.0)
                let rx = to_i32(floor(c.rx * 8.0 + 0.5))
                let ry = to_i32(floor(c.ry * 8.0 + 0.5))
                let mut s = a_texto(c.x) + " " + a_texto(c.y) + " " + a_texto(rx) + " " + a_texto(ry)
                s = s + " " + a_texto(b(c.suelo)) + a_texto(b(c.techo)) + " " + a_texto(c.pared)
                s = s + " " + a_texto(b(c.vx == 0.0)) + a_texto(b(c.vy == 0.0))
                s = s + " " + a_texto(b(juego.pisa(m, c.x, c.y, c.w, c.h))) + a_texto(b(juego.sobre_suelo(m, c)))
                print("M " + a_texto(k) + " " + a_texto(q) + " " + a_texto(j) + " " + s)
            }
        }
    }
}

fn camaras(d: json.Doc) {
    for k in 0..json.largo(d, "camaras") {
        let r = "camaras." + a_texto(k)
        let c = juego.camara(n(d, r + ".ancho"), n(d, r + ".alto"), n(d, r + ".mw"), n(d, r + ".mh"))
        for j in 0..json.largo(d, r + ".ops") {
            let ro = r + ".ops." + a_texto(j)
            let tipo = json.texto(d, ro + ".0")
            let a = n(d, ro + ".1")
            let bb = n(d, ro + ".2")
            let mut s = ""
            if tipo == "mirar" {
                juego.mirar(c, a, bb)
            }
            if tipo == "centrar" {
                juego.centrar(c, a, bb)
            }
            if tipo == "suavizar" {
                juego.suavizar(c, a, bb, n(d, ro + ".3"), n(d, ro + ".4"))
            }
            s = a_texto(c.x) + " " + a_texto(c.y) + " " + a_texto(juego.pantalla_x(c, a)) + " " + a_texto(juego.pantalla_y(c, bb))
            s = s + " " + a_texto(juego.mundo_x(c, a)) + " " + a_texto(juego.mundo_y(c, bb))
            s = s + " " + a_texto(b(juego.visible(c, a, bb, 1 + (a + bb) % 37 + 37, 1 + (a * 3 + bb) % 29 + 29)))
            print("C " + a_texto(k) + " " + a_texto(j) + " " + s)
        }
    }
}

fn entradas(d: json.Doc) {
    for k in 0..json.largo(d, "entradas") {
        let r = "entradas." + a_texto(k)
        let mut codigos: Vec<i32> = vec_new()
        for i in 0..json.largo(d, r + ".codigos") {
            codigos.push(n(d, r + ".codigos." + a_texto(i)))
        }
        let e = juego.entrada(codigos)
        for j in 0..json.largo(d, r + ".pasos") {
            let rp = r + ".pasos." + a_texto(j)
            juego.siguiente(e)
            for i in 0..json.largo(d, rp) {
                juego.fijar(e, n(d, rp + "." + a_texto(i) + ".0"), n(d, rp + "." + a_texto(i) + ".1") == 1)
            }
            let mut s = ""
            for i in 0..json.largo(d, r + ".consulta") {
                let cod = n(d, r + ".consulta." + a_texto(i))
                s = s + a_texto(b(juego.sostenida(e, cod))) + a_texto(b(juego.apretada(e, cod))) + a_texto(b(juego.soltada(e, cod))) + " "
            }
            s = s + a_texto(juego.eje(e, n(d, r + ".consulta.0"), n(d, r + ".consulta.1")))
            print("E " + a_texto(k) + " " + a_texto(j) + " " + s)
        }
    }
}

fn lienzo_de(d: json.Doc, r: str) -> lienzo.Lienzo {
    let w = n(d, r + ".w")
    let h = n(d, r + ".h")
    let l = lienzo.nuevo(w, h, 0)
    for i in 0..w * h {
        lienzo.poner(l, i % w, i / w, n(d, r + ".px." + a_texto(i)))
    }
    return l
}

fn hojas(d: json.Doc) -> Result<i32> {
    for k in 0..json.largo(d, "hojas") {
        let r = "hojas." + a_texto(k)
        let cw = n(d, r + ".cw")
        let ch = n(d, r + ".ch")
        let h = juego.hoja(lienzo_de(d, r + ".img"), cw, ch)
        imagen.guardar_png(lienzo_de(d, r + ".img"), "hoja.png")?
        let hp = juego.hoja_png("hoja.png", cw, ch)?
        let a = lienzo_de(d, r + ".dest")
        let p = lienzo_de(d, r + ".dest")
        for j in 0..json.largo(d, r + ".ops") {
            let ro = r + ".ops." + a_texto(j)
            let i = n(d, ro + ".1")
            let x = n(d, ro + ".2")
            let y = n(d, ro + ".3")
            if n(d, ro + ".0") == 0 {
                juego.dibujar(a, h, i, x, y)
                juego.dibujar(p, hp, i, x, y)
            } else {
                juego.dibujar_espejo(a, h, i, x, y)
                juego.dibujar_espejo(p, hp, i, x, y)
            }
        }
        print("H " + a_texto(k) + " " + a_texto(juego.cuadros(h)) + " " + a_texto(lienzo.suma(a)) + " " + a_texto(lienzo.suma(p)))
    }
    return Ok(0)
}

fn dibujos(d: json.Doc) {
    for k in 0..json.largo(d, "dibujos") {
        let r = "dibujos." + a_texto(k)
        let m = mapa_de(d, r)
        let h = juego.hoja(lienzo_de(d, r + ".img"), n(d, r + ".cw"), n(d, r + ".ch"))
        let dest = lienzo.nuevo(n(d, r + ".vw"), n(d, r + ".vh"), lienzo.color(10, 20, 30))
        let cam = juego.camara(n(d, r + ".vw"), n(d, r + ".vh"), juego.ancho_mundo(m), juego.alto_mundo(m))
        juego.mirar(cam, n(d, r + ".cx"), n(d, r + ".cy"))
        juego.dibujar_mapa(dest, m, h, cam)
        print("D " + a_texto(k) + " " + a_texto(cam.x) + " " + a_texto(cam.y) + " " + a_texto(lienzo.suma(dest)))
    }
}

fn correr() -> Result<i32> {
    let d = json.leer_archivo("casos.json")?
    relojes(d)
    animaciones(d)
    textos(d)
    cuerpos(d)
    camaras(d)
    entradas(d)
    hojas(d)?
    dibujos(d)
    return Ok(0)
}

fn main() -> i32 {
    let r = correr()
    match r {
        Ok(x) => {
            return 0
        }
        Err(e) => {
            print("ERROR " + e)
            return 1
        }
    }
    return 1
}
