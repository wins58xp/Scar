# lib/grafos: el camino más corto entre ciudades (Dijkstra), el árbol de cables más barato que las une a
# todas, el orden para hacer tareas que dependen unas de otras, y un monstruo que busca al jugador en un
# laberinto con A* (en 4 y en 8 direcciones), dibujado con letras.

use "grafos"

fn nombres(i: i32) -> str {
    let todos = "Arica|Iquique|Antofagasta|La Serena|Santiago|Concepción|Temuco|Puerto Montt"
    let mut k = 0
    let mut r = ""
    for j in 0..len(todos) {
        let c = todos[j]
        if c == "|" {
            k = k + 1
        } else {
            if k == i {
                r = r + c
            }
        }
    }
    return r
}

fn ruta_texto(v: Vec<i32>) -> str {
    let mut s = ""
    for i in 0..v.len() {
        if i > 0 {
            s = s + " -> "
        }
        s = s + nombres(v.get(i).unwrap_or(0))
    }
    return s
}

fn tareas(g: grafos.Grafo) -> Result<i32> {
    let o = grafos.orden_topologico(g)?
    let mut s = ""
    let nom = "comprar|cocinar|poner la mesa|comer|lavar"
    for i in 0..o.len() {
        let t = o.get(i).unwrap_or(0)
        let mut k = 0
        let mut palabra = ""
        for j in 0..len(nom) {
            if nom[j] == "|" {
                k = k + 1
            } else {
                if k == t {
                    palabra = palabra + nom[j]
                }
            }
        }
        s = s + " " + a_texto(i + 1) + "." + palabra
    }
    print("orden de las tareas:" + s)
    return Ok(0)
}

fn dibujar(gr: grafos.Grilla, plano: str, ruta: Vec<i32>) {
    let marcas: Vec<i32> = vec_new()
    for i in 0..gr.ancho * gr.alto {
        marcas.push(0)
    }
    for i in 0..ruta.len() {
        marcas.set(ruta.get(i).unwrap_or(0), 1)
    }
    for y in 0..gr.alto {
        let mut fila = ""
        for x in 0..gr.ancho {
            let c = y * gr.ancho + x
            let p = plano[c]
            if p == "#" or p == "M" or p == "J" {
                fila = fila + p
            } else {
                if marcas.get(c).unwrap_or(0) == 1 {
                    fila = fila + "*"
                } else {
                    fila = fila + " "
                }
            }
        }
        print("  " + fila)
    }
}

fn main() -> i32 {
    # rutas entre ciudades, en kilómetros (aproximados)
    let g = grafos.grafo(8, false)
    grafos.arista(g, 0, 1, 310.0)
    grafos.arista(g, 1, 2, 410.0)
    grafos.arista(g, 2, 3, 880.0)
    grafos.arista(g, 3, 4, 470.0)
    grafos.arista(g, 4, 5, 500.0)
    grafos.arista(g, 5, 6, 290.0)
    grafos.arista(g, 6, 7, 340.0)
    grafos.arista(g, 4, 6, 680.0)
    grafos.arista(g, 2, 4, 1360.0)
    let c = grafos.dijkstra(g, 0)
    print("de Arica a Puerto Montt: " + a_texto(grafos.distancia(c, 7)) + " km")
    print("  " + ruta_texto(grafos.camino(c, 7)))
    let arbol = grafos.arbol_minimo(g)
    print("cables más baratos para unir todo: " + a_texto(arbol.len()) + " tramos, " + a_texto(grafos.peso_total(g, grafos.arbol_minimo(g))) + " km")
    # tareas: 0 comprar, 1 cocinar, 2 poner la mesa, 3 comer, 4 lavar
    let t = grafos.grafo(5, true)
    grafos.arista(t, 0, 1, 1.0)
    grafos.arista(t, 1, 3, 1.0)
    grafos.arista(t, 2, 3, 1.0)
    grafos.arista(t, 3, 4, 1.0)
    let r = tareas(t)
    grafos.arista(t, 4, 0, 1.0)
    if tareas(t).is_err() {
        print("con 'lavar antes de comprar' hay un ciclo: no hay orden posible")
    }
    # el laberinto
    let plano = "M.....#.........#.........#..###...........#.......#####.....#........###......J....#...#.......#....#####...#................"
    let ancho = 20
    let alto = 6
    let gr = grafos.grilla(ancho, alto)
    let mut mx = 0
    let mut my = 0
    let mut jx = 0
    let mut jy = 0
    for i in 0..len(plano) {
        if plano[i] == "#" {
            grafos.pared(gr, i % ancho, i / ancho)
        }
        if plano[i] == "M" {
            mx = i % ancho
            my = i / ancho
        }
        if plano[i] == "J" {
            jx = i % ancho
            jy = i / ancho
        }
    }
    print("el monstruo (M) busca al jugador (J), en 4 direcciones: " + a_texto(grafos.costo(gr, grafos.a_estrella(gr, mx, my, jx, jy, false))) + " pasos")
    dibujar(gr, plano, grafos.a_estrella(gr, mx, my, jx, jy, false))
    print("en 8 direcciones: " + a_texto(grafos.costo(gr, grafos.a_estrella(gr, mx, my, jx, jy, true))))
    dibujar(gr, plano, grafos.a_estrella(gr, mx, my, jx, jy, true))
    return 0
}
