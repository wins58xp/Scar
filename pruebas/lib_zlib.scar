# lib/zlib, probada con lib/prueba.
#
# Ida y vuelta con datos chicos (vacíos, repetidos, todos los bytes, más de un
# bloque guardado), flujos hechos por el zlib de C con Huffman fijo y con
# Huffman dinámico (copiados acá como arreglos), las sumas de control con
# valores conocidos, y los errores (encabezado roto, Adler-32 cambiado,
# cortado, bloque de tipo 3). La comparación grande con zlib está en
# pruebas/test_zlib_python.py. Termina con el código de salida de prueba.

use "prueba"
use "zlib"

fn iguales(a: Vec<i32>, b: Vec<i32>) -> bool {
    if a.len() != b.len() {
        return false
    }
    for i in 0..a.len() {
        if a.get(i).unwrap_or(0 - 1) != b.get(i).unwrap_or(0 - 2) {
            return false
        }
    }
    return true
}

fn texto_a_bytes(s: str) -> Vec<i32> {
    let mut v: Vec<i32> = vec_new()
    for i in 0..len(s) {
        v.push(ord(s[i]))
    }
    return v
}

# Los datos de prueba número k (se arman de nuevo cada vez: una fn que recibe
# un Vec se queda con él, así que no se pueden reusar).
fn datos(k: i32) -> Vec<i32> {
    let mut v: Vec<i32> = vec_new()
    if k == 1 {
        v.push(7)
    } else if k == 2 {
        return texto_a_bytes("holaholaholaholahola, ñandú")
    } else if k == 3 {
        for i in 0..1000 {
            v.push((i * 7 + i / 13) % 256)
        }
    } else if k == 4 {
        for i in 0..3000 {
            v.push(0)
        }
    }
    return v
}

fn ida_y_vuelta(k: i32, guardado: bool) -> bool {
    let z = if guardado { zlib.comprimir_guardado(datos(k)) } else { zlib.comprimir(datos(k)) }
    let mut bien = false
    match zlib.descomprimir(z) {
        Ok(v) => { bien = iguales(v, datos(k)) }
        Err(e) => { print("   ", e) }
    }
    return bien
}

fn main() -> i32 {
    let t = prueba.nueva("zlib")

    prueba.seccion(t, "sumas de control")
    prueba.afirmar_igual_i32(t, zlib.crc32(texto_a_bytes("123456789")), 0 - 873187034, "crc32 de 123456789 (0xCBF43926)")
    prueba.afirmar_igual_i32(t, zlib.adler32(texto_a_bytes("Wikipedia")), 300286872, "adler32 de Wikipedia")
    prueba.afirmar_igual_i32(t, zlib.crc32(vec_new()), 0, "crc32 de nada")
    prueba.afirmar_igual_i32(t, zlib.adler32(vec_new()), 1, "adler32 de nada")

    prueba.seccion(t, "ida y vuelta")
    prueba.afirmar(t, ida_y_vuelta(0, false), "vacío")
    prueba.afirmar(t, ida_y_vuelta(1, false), "un byte")
    prueba.afirmar(t, ida_y_vuelta(2, false), "repetido")
    prueba.afirmar(t, ida_y_vuelta(3, false), "1000 bytes variados")
    let largo_ceros = zlib.comprimir(datos(4)).len()
    prueba.afirmar(t, largo_ceros < 40, "3000 ceros ocupan poco (" + a_texto(largo_ceros) + " bytes)")
    prueba.afirmar(t, ida_y_vuelta(4, false), "3000 ceros")
    prueba.afirmar(t, ida_y_vuelta(3, true), "sin comprimir")
    # dos bloques guardados seguidos (el primero no es el último): 1 2 3 y 4 5
    let dos_bloques = [120, 1, 0, 3, 0, 252, 255, 1, 2, 3, 1, 2, 0, 253, 255, 4, 5, 0, 40, 0, 16]
    match zlib.descomprimir(dos_bloques) {
        Ok(v) => { prueba.afirmar(t, iguales(v, [1, 2, 3, 4, 5]), "dos bloques guardados") }
        Err(e) => { prueba.afirmar(t, false, "dos bloques guardados: " + e) }
    }
    let crudo = zlib.deflate(texto_a_bytes("abcabcabc"))
    match zlib.inflate(crudo) {
        Ok(v) => { prueba.afirmar(t, iguales(v, texto_a_bytes("abcabcabc")), "deflate/inflate sin encabezado") }
        Err(e) => { prueba.afirmar(t, false, e) }
    }

    prueba.seccion(t, "lo que comprime zlib de C")
    # zlib.compress(b"abcabcabcabc hola hola hola", 9): Huffman fijo
    let fijo = [120, 218, 75, 76, 74, 78, 132, 33, 133, 140, 252, 156, 68, 4, 1, 0, 139, 165, 9, 229]
    match zlib.descomprimir(fijo) {
        Ok(v) => { prueba.afirmar(t, iguales(v, texto_a_bytes("abcabcabcabc hola hola hola")), "Huffman fijo") }
        Err(e) => { prueba.afirmar(t, false, "Huffman fijo: " + e) }
    }
    # zlib.compress("En un lugar de la Mancha...".encode(), 9): Huffman dinámico
    let dinamico = [120, 218, 21, 140, 193, 13, 128, 32, 16, 4, 91, 217, 2, 104, 195, 167, 69, 172, 112, 1, 18,
                    224, 244, 226, 153, 88, 148, 85, 216, 152, 242, 218, 204, 100, 178, 203, 128, 15, 52, 207, 52,
                    36, 65, 35, 86, 142, 88, 24, 38, 69, 191, 21, 67, 251, 102, 242, 15, 14, 175, 98, 10, 70, 181,
                    68, 235, 18, 166, 44, 68, 247, 88, 20, 103, 149, 190, 207, 72, 112, 213, 235, 125, 56, 143, 75,
                    77, 108, 89, 63, 46, 148, 36, 240]
    let quijote = "En un lugar de la Mancha, de cuyo nombre no quiero acordarme, no ha mucho tiempo que vivía un hidalgo"
    let mut esperado: Vec<i32> = vec_new()
    # el texto en UTF-8: la í son dos bytes
    for i in 0..len(quijote) {
        let c = ord(quijote[i])
        if c < 128 {
            esperado.push(c)
        } else {
            esperado.push(192 | (c >> 6))
            esperado.push(128 | (c & 63))
        }
    }
    match zlib.descomprimir(dinamico) {
        Ok(v) => { prueba.afirmar(t, iguales(v, esperado), "Huffman dinámico") }
        Err(e) => { prueba.afirmar(t, false, "Huffman dinámico: " + e) }
    }

    prueba.seccion(t, "errores")
    prueba.afirmar(t, zlib.descomprimir([120, 157, 1, 2, 3, 4, 5, 6]).is_err(), "encabezado roto")
    prueba.afirmar(t, zlib.descomprimir([120, 218, 75, 76, 74, 78, 132, 33, 133, 140, 252, 156, 68, 4, 1, 0, 139, 165, 9, 228]).is_err(),
                   "Adler-32 cambiado")
    prueba.afirmar(t, zlib.descomprimir([120, 218, 75, 76, 74, 78, 132, 33]).is_err(), "cortado")
    prueba.afirmar(t, zlib.descomprimir([120, 156, 7, 0, 0, 0, 0, 1]).is_err(), "bloque de tipo 3")
    match zlib.descomprimir([120, 187, 0, 0, 0, 1, 3, 0]) {
        Ok(v) => { prueba.afirmar(t, false, "diccionario: tenía que dar Err") }
        Err(e) => { prueba.afirmar_igual_str(t, e, "zlib: usa un diccionario prearmado (no se puede sin él)", "diccionario") }
    }

    return prueba.terminar(t)
}
